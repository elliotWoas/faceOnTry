# Google AI Studio / Gemini API key
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Replicate API token
# Get token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
